# Server
PORT=3000
HOST=127.0.0.1

# Room geometry (metres)
ROOM_WIDTH=20
ROOM_HEIGHT=15
GRID_RESOLUTION=1

# Simulation loop
UPDATE_RATE=500

# Samples kept in the rolling time-series buffer. At UPDATE_RATE=500 this is
# 240 samples = the last two minutes.
HISTORY_CAPACITY=240

# RSSI display range (dBm)
MIN_RSSI=-100
MAX_RSSI=-20

# A grid cell above this RSSI counts as a hotspot in the coverage panel (dBm)
HOTSPOT_THRESHOLD=-40

# Measured readings. Leave READINGS_TOKEN unset on a local machine. Set it
# before exposing ingest anywhere: the endpoint is open otherwise.
# Docs: docs/real-data.md
READINGS_TOKEN=

# ---- Public demo mode ----
# DEMO_MODE=1 turns the app into a public copy: ingest is refused, commands are
# rate limited per client, the client count is capped, the room resets after
# DEMO_IDLE_RESET_MS of inactivity, and a banner says the room is shared.
# Every one of these below is ignored unless DEMO_MODE=1.
DEMO_MODE=0
DEMO_RATE_LIMIT=20
DEMO_MAX_CLIENTS=50
DEMO_IDLE_RESET_MS=600000

# Comma-separated Origin allowlist for the WebSocket. Empty means no check.
# Only consulted in demo mode.
ALLOWED_ORIGINS=
