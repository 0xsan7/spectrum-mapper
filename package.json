{
  "name": "spectrum-mapper",
  "version": "1.2.0",
  "description": "Interactive 2.4 GHz RF coverage simulator with RSSI trilateration. Log-distance path loss, wall attenuation and a live heatmap streamed over WebSocket.",
  "keywords": [
    "rssi",
    "rf",
    "wifi",
    "bluetooth",
    "heatmap",
    "trilateration",
    "path-loss",
    "signal-strength",
    "indoor-positioning",
    "wireless",
    "simulation",
    "websocket",
    "nodejs",
    "express",
    "canvas"
  ],
  "homepage": "https://spectrum-mapper-demo.onrender.com",
  "bugs": {
    "url": "https://github.com/0xsan7/spectrum-mapper/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xsan7/spectrum-mapper.git"
  },
  "author": "0xsan7",
  "license": "MIT",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/**/*.test.js\"",
    "benchmark": "node scripts/benchmark.js",
    "verify:readme": "node scripts/verify-readme.js",
    "verify:diagrams": "node scripts/verify-diagrams.js",
    "tree": "node scripts/gen-tree.js --write",
    "verify": "npm run lint && npm run format:check && npm test && npm run verify:readme && npm run verify:diagrams"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "fast-xml-parser": "^5.11.2",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "yaml": "^2.9.1"
  }
}
