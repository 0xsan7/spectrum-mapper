{
  "name": "spectrum-mapper",
  "version": "1.0.0",
  "description": "Real-time RF signal strength (RSSI) heatmap mapper with log-distance path loss, wall obstacles, and trilateration",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/**/*.test.js\"",
    "benchmark": "node scripts/benchmark.js",
    "verify:readme": "node scripts/verify-readme.js",
    "verify:diagrams": "node scripts/verify-diagrams.js",
    "tree": "node scripts/gen-tree.js --write",
    "verify": "npm run lint && npm run format:check && npm test && npm run verify:readme && npm run verify:diagrams"
  },
  "keywords": [
    "rssi",
    "rf",
    "wifi",
    "heatmap",
    "path-loss",
    "trilateration",
    "signal-strength",
    "canvas",
    "websocket"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.9"
  }
}
